# NAV — Navigate, Analyze, Validate
# .gitignore

# ── Environment variables ─────────────────────────────────
.env
.env.local
.env.production
backend/.env

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
*.pyc

# ── Node ──────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*

# ── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Uploads (temp) ────────────────────────────────────────
uploads/
temp/
